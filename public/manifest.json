{
  "manifest_version": 3,
  "name": "Cosytales Productivity Extension",
  "version": "1.0",
  "description": "Cosytales Productivity Extension",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "offscreen", "notifications", "tabs"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Cosytales Productivity"
  },
  "background": {
    "service_worker": "background.js"
  }
}